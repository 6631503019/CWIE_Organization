# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cwie_organization
MONGODB_URI_FALLBACK=mongodb://127.0.0.1:27017/cwie_organization

# Existing JWT settings
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin SDK
# Create a service account in Firebase Console > Project settings > Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \\n sequences, or replace them with real newlines when loading the key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"

# Only accounts from this Google Workspace domain may sign in
GOOGLE_WORKSPACE_DOMAINS=mfu.ac.th,lamduan.mfu.ac.th
ADMIN_GOOGLE_EMAIL=6631503019@lamduan.mfu.ac.th

# File Upload
MAX_FILE_SIZE=10485760
